<style>
  @media (min-width: 768px) {
    #gfc-ig-{{ section.id }} .gfc-ig-grid {
      grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
    }
  }
</style>

<section class="py-24 border-y border-stone-800" id="gfc-ig-{{ section.id }}">
  <div class="page-width mx-auto px-12">

    <!-- Header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-6xl font-headline mb-4 uppercase text-brand-offwhite">{{ section.settings.heading }}</h2>
      <p class="text-brand-silver text-xl font-body">{{ section.settings.subheading }}</p>
    </div>

    <!-- Grid -->
    <div class="grid gfc-ig-grid grid-cols-2 gap-4">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'photo' -%}
            <div class="aspect-square relative overflow-hidden rounded-lg group" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt="{{ block.settings.image.alt | default: 'Social photo' }}"
                  width="600"
                  height="600"
                  loading="lazy"
                >
              {%- else -%}
                <div class="w-full h-full bg-stone-800 flex items-center justify-center">
                  <span class="material-symbols-outlined text-6xl text-stone-600">photo_camera</span>
                </div>
              {%- endif -%}

              <div class="absolute inset-0 bg-brand-burgundy/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                <span class="material-symbols-outlined text-4xl text-brand-offwhite">favorite</span>
              </div>

              {%- if block.settings.link != blank -%}
                <a class="absolute inset-0" href="{{ block.settings.link }}" aria-label="View post"></a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <!-- CTA -->
    {%- if section.settings.instagram_handle != blank -%}
      <div class="text-center mt-12">
        <a class="inline-flex items-center gap-2 text-brand-silver hover:text-brand-offwhite transition-colors font-body text-lg" href="https://instagram.com/{{ section.settings.instagram_handle | remove: '@' }}" target="_blank" rel="noopener">
          <span class="material-symbols-outlined">photo_camera</span>
          @{{ section.settings.instagram_handle | remove: '@' }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "GFC Instagram Grid",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE VIBE CHECK"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Tag @GODSFAVORITECOFFEE for a chance to be featured in the temple."
    },
    {
      "type": "text",
      "id": "instagram_handle",
      "label": "Instagram Handle",
      "default": "@godsfavoritecoffee"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GFC Instagram Grid",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
