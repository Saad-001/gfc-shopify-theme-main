<style>
  .gfc__product-card:before {
    content: "";
    position: absolute;
    top: 14.5%;
    bottom: 0;
    left: 0;
    width: 100%;
    border-radius: 35px;
    z-index: -1;
    border: 3px solid #ffffff;
    box-shadow: 0 0 0px 0px #ffffff;
    transition: border-color 0.4s ease, box-shadow 0.4s ease;
  }

  .gfc__product-card:hover:before {
    border-color: var(--gfc-card-glow, #ffffff);
    box-shadow:
      0 0 14px 3px var(--gfc-card-glow, #ffffff),
      0 0 40px 8px color-mix(in srgb, var(--gfc-card-glow, #ffffff) 35%, transparent);
  }

  .gfc__product-image-wrapper img {
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    transform-origin: bottom center;
  }

  .group:hover .gfc__product-image-wrapper img {
    transform: rotate(8deg);
  }
</style>

<section class="py-24 px-12 page-width mx-auto" id="gfc-fp-{{ section.id }}">
  <!-- Header -->
  <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8">
    <div class="max-w-2xl">
      <h2 class="text-5xl md:text-7xl font-headline leading-none mb-4 uppercase text-brand-offwhite">
        {{ section.settings.heading_prefix }}
        <span class="text-stone-500">{{ section.settings.heading_accent }}</span>
      </h2>
      <p class="text-brand-silver text-xl font-body">{{ section.settings.subheading }}</p>
    </div>
    <a class="text-brand-silver hover:text-red-600 transition-colors flex items-center gap-2 text-xl font-medium font-body" href="{{ section.settings.collection_link }}">
      VIEW ALL ROASTS <span class="material-symbols-outlined">arrow_forward</span>
    </a>
  </div>

  <!-- Product Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'product_card' -%}
          {%- render 'gfc-product-card',
            product: block.settings.product,
            custom_title: block.settings.custom_title,
            custom_price: block.settings.custom_price,
            glow_color: block.settings.glow_color,
            badge: block.settings.badge,
            badge_style: block.settings.badge_style,
            shopify_attributes: block.shopify_attributes
          -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "GFC Featured Products",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading Prefix",
      "default": "THE DIVINE"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading Accent",
      "default": "COLLECTION"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our small-batch roasts are carefully curated for depth, character, and spirit."
    },
    {
      "type": "url",
      "id": "collection_link",
      "label": "View All Link"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title (if no product)",
          "default": "MORNING MASS"
        },
        {
          "type": "text",
          "id": "custom_price",
          "label": "Custom Price (if no product)",
          "default": "$19"
        },
        {
          "type": "textarea",
          "id": "custom_desc",
          "label": "Custom Description (if no product)",
          "default": "Dark roast with notes of smoked cocoa, toasted oak, and morning clarity."
        },
        {
          "type": "color",
          "id": "glow_color",
          "label": "Hover Border & Glow Color",
          "default": "#ffffff"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Label (e.g. BEST SELLER)"
        },
        {
          "type": "select",
          "id": "badge_style",
          "label": "Badge Style",
          "options": [
            { "value": "primary", "label": "Burgundy" },
            { "value": "secondary", "label": "Stone" },
            { "value": "danger", "label": "Dark Red" }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GFC Featured Products",
      "blocks": [
        {
          "type": "product_card",
          "settings": {
            "custom_title": "MORNING MASS",
            "custom_price": "$19",
            "custom_desc": "Dark roast with notes of smoked cocoa, toasted oak, and morning clarity.",
            "badge": "BEST SELLER",
            "badge_style": "primary"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "custom_title": "ALMOST HOLY",
            "custom_price": "$21",
            "custom_desc": "Medium roast featuring a balanced profile of honey-crisp apple and walnut."
          }
        },
        {
          "type": "product_card",
          "settings": {
            "custom_title": "SOUL AWAKENING",
            "custom_price": "$24",
            "custom_desc": "Bright light roast with vibrant floral notes and a smooth citrus finish.",
            "badge": "NEW ARRIVAL",
            "badge_style": "secondary"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "custom_title": "MIDNIGHT VIGIL",
            "custom_price": "$22",
            "custom_desc": "The ultimate espresso blend. Thick crema, heavy body, and soulful depth.",
            "badge": "LIMITED",
            "badge_style": "danger"
          }
        }
      ]
    }
  ]
}
{% endschema %}
