          "info": "Overrides the product's featured image"
        },
        {
          "type": "header",
          "content": "Slide Colors"
        },
        {
          "type": "color",
          "id": "slide_bg_color",
          "label": "Slide Background Color",
          "default": "#2c1810"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color (title, price, options, rating)",
          "default": "#ffffff",
          "info": "Applies to all text on this slide"
        },
        {
          "type": "color",
