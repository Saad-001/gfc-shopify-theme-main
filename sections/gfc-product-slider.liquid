{{ 'https://cdn.jsdelivr.net/npm/swiper@8/swiper-bundle.min.css' | stylesheet_tag }}

<style>
  #gfc-ps-{{ section.id }} {
    --gfc-accent: {{ section.settings.accent_color }};

    width: 100%;
    min-height: 100vh;
    background-color: {{ section.settings.section_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 50px 0px;
    box-sizing: border-box;
    position: relative;
    font-family: "Poppins", sans-serif;
    flex-direction: column;
  }

  /* ---- Optional section heading ---- */
  #gfc-ps-{{ section.id }} .gfc-ps__section-heading {
    font-family: "HVD Poster", serif;
    font-size: 6.5rem;
    font-weight: 700;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: {{ section.settings.heading_color }};
    margin-bottom: 28px;
    text-align: center;
    width: 100%;
    max-width: 1100px;
  }

  #gfc-ps-{{ section.id }} .gfc-ps__inner {
    width: 100%;
    max-width: 1100px;
    height: 560px;
    position: relative;
    margin: 0 auto;
  }

  /* ---- Left accent panel ---- */
  #gfc-ps-{{ section.id }} .gfc-ps__bg-shape {
    height: 100%;
    background: {{ section.settings.bg_shape_color }};
    box-shadow: 0 30px 100px rgba(0,0,0,.22);
    border-radius: 28px;
    width: 48%;
    position: absolute;
    top: 0;
    left: 0;
  }

  /* ---- Floating product image ---- */
  #gfc-ps-{{ section.id }} .gfc-ps__product-img {
    position: absolute;
    z-index: 2;
    width: 280px;
    left: 24%;
    top: 50%;
    transform: translateX(-45%) translateY(-50%);
    height: 88%;
    max-height: 500px;
    pointer-events: none;
  }

  #gfc-ps-{{ section.id }} .gfc-ps__product-img-item {
    display: flex;
    align-items: center;
    position: absolute;
    pointer-events: none;
    user-select: none;
    top: 50%;
    right: 0;
    transform: translateY(-50%) translateX(-120px);
    opacity: 0;
    transition: opacity .35s, transform .35s;
    width: 100%;
    height: 100%;
  }

  #gfc-ps-{{ section.id }} .gfc-ps__product-img-item.is-active {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
    transition-delay: .25s;
  }

  #gfc-ps-{{ section.id }} .gfc-ps__product-img-item img {
    object-fit: contain;
    object-position: center;
    width: 100%;
    height: 100%;
    max-height: 460px;
  }

  /* ---- Nav buttons (outside swiper, inside .gfc-ps__inner) ---- */
  #gfc-ps-{{ section.id }} .gfc-ps__nav-btn {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: inline-flex;
    border: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    background: #fff;
    color: #333;
    box-shadow: 0 4px 16px rgba(0,0,0,.18);
    transition: box-shadow .2s;
    outline: none;
  }

  #gfc-ps-{{ section.id }} .gfc-ps__nav-btn:hover {
    box-shadow: 0 6px 24px rgba(0,0,0,.28);
  }

  #gfc-ps-{{ section.id }} .gfc-ps__nav-btn svg {
    width: 17px;
    height: 17px;
    fill: currentColor;
    flex-shrink: 0;
  }

  #gfc-ps-{{ section.id }} .gfc-ps__prev {
    left: 0;
    transform: translate(-50%, -50%);
  }

  #gfc-ps-{{ section.id }} .gfc-ps__next {
    right: 0;
    transform: translate(50%, -50%);
  }

  /* ---- Slider (no overflow:hidden — card handles clipping) ---- */
  #gfc-ps-{{ section.id }} .gfc-ps__slider {
    width: 76%;
    height: 88%;
    border-radius: 28px;
    box-shadow: 0 24px 70px rgba(0,0,0,.3);
    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
  }

  #gfc-ps-{{ section.id }} .gfc-ps__slider .swiper-wrapper {
    height: 100%;
  }

  /* ---- Slide & card ---- */
  #gfc-ps-{{ section.id }} .gfc-ps__slide {
    height: 100%;
  }

  #gfc-ps-{{ section.id }} .gfc-ps__card {
    /* --gfc-text is set inline per slide for per-product text colour */
    height: 100%;
    width: 100%;
    display: flex;
    align-items: center;
    overflow: hidden;
    position: relative;
    border-radius: 28px;
  }

  /* ---- Content ---- */
  #gfc-ps-{{ section.id }} .gfc-ps__content {
    color: var(--gfc-text, #fff);
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 30px 60px 30px 250px;
  }

  /* Stagger entrance on active slide */
  #gfc-ps-{{ section.id }} .gfc-ps__slide .gfc-ps__content > * {
    opacity: 0;
    transform: translateY(36px);
    transition: opacity .42s, transform .42s;
  }

  #gfc-ps-{{ section.id }} .gfc-ps__slide.swiper-slide-active .gfc-ps__content > * {
    opacity: 1;
    transform: none;
  }

  #gfc-ps-{{ section.id }} .gfc-ps__slide.swiper-slide-active .gfc-ps__content > *:nth-child(1) { transition-delay: 0s; }
  #gfc-ps-{{ section.id }} .gfc-ps__slide.swiper-slide-active .gfc-ps__content > *:nth-child(2) { transition-delay: .12s; }
  #gfc-ps-{{ section.id }} .gfc-ps__slide.swiper-slide-active .gfc-ps__content > *:nth-child(3) { transition-delay: .24s; }
  #gfc-ps-{{ section.id }} .gfc-ps__slide.swiper-slide-active .gfc-ps__content > *:nth-child(4) { transition-delay: .36s; }

  /* ---- Badge ---- */
  #gfc-ps-{{ section.id }} .gfc-ps__badge {
    display: inline-block;
    background: var(--gfc-accent);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    padding: 4px 14px;
    border-radius: 50px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  /* ---- Title ---- */
  #gfc-ps-{{ section.id }} .gfc-ps__title {
    margin: 0 0 10px;
    font-family: "HVD Poster", serif;
    font-size: 38px;
    line-height: 1.15;
    letter-spacing: .04em;
    color: var(--gfc-text, #fff);
    text-transform: uppercase;
  }

  /* ---- Price ---- */
  #gfc-ps-{{ section.id }} .gfc-ps__price {
    display: block;
    font-family: "HVD Poster", serif;
    font-size: 36px;
    color: var(--gfc-text, #fff);
  }

  #gfc-ps-{{ section.id }} .gfc-ps__price s {
    font-size: .55em;
    opacity: .5;
    margin-left: 8px;
    font-weight: 400;
  }

  /* ---- Variant options ---- */
  #gfc-ps-{{ section.id }} .gfc-ps__ctr {
    display: flex;
    align-items: flex-start;
    margin-top: 22px;
  }

  #gfc-ps-{{ section.id }} .gfc-ps__labels-wrap {
    flex: 1;
    min-width: 0;
  }

  #gfc-ps-{{ section.id }} .gfc-ps__labels-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gfc-text, #fff);
    opacity: .7;
    margin-bottom: 8px;
  }

  #gfc-ps-{{ section.id }} .gfc-ps__labels-group {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 12px;
  }

  #gfc-ps-{{ section.id }} .gfc-ps__labels-group:last-child {
    margin-bottom: 0;
  }

  #gfc-ps-{{ section.id }} .gfc-ps__label-checkbox {
    display: none;
  }

  #gfc-ps-{{ section.id }} .gfc-ps__label-txt {
    display: block;
    border: 2px solid rgba(255,255,255,.25);
    font-size: 11px;
    font-weight: 600;
    padding: 6px 13px;
    border-radius: 50px;
    transition: border-color .2s, background .2s;
    letter-spacing: 1.5px;
    color: var(--gfc-text, #fff);
    cursor: pointer;
    white-space: nowrap;
    text-transform: uppercase;
  }

  #gfc-ps-{{ section.id }} .gfc-ps__label-checkbox:checked + .gfc-ps__label-txt {
    border-color: var(--gfc-accent);
    background: rgba(255,255,255,.1);
  }

  /* ---- Divider ---- */
  #gfc-ps-{{ section.id }} .gfc-ps__hr-v {
    width: 1px;
    background: rgba(255,255,255,.2);
    align-self: stretch;
    margin: 0 22px;
    flex-shrink: 0;
  }

  /* ---- Rating circle ---- */
  #gfc-ps-{{ section.id }} .gfc-ps__rating {
    text-align: center;
    flex-shrink: 0;
  }

  #gfc-ps-{{ section.id }} .gfc-ps__rating-percent {
    position: relative;
    width: 90px;
    height: 90px;
    margin: 0 auto 8px;
  }

  #gfc-ps-{{ section.id }} .gfc-ps__rating-num {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: var(--gfc-text, #fff);
    font-size: 15px;
    font-weight: 700;
  }

  #gfc-ps-{{ section.id }} .gfc-ps__rating-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gfc-text, #fff);
    opacity: .75;
    display: block;
  }

  /* ---- Add to Cart ---- */
  #gfc-ps-{{ section.id }} .gfc-ps__bottom {
    margin-top: 22px;
  }

  #gfc-ps-{{ section.id }} .gfc-ps__cart-btn {
    border: none;
    color: #fff;
    padding: 13px 36px;
    border-radius: 50px;
    min-height: 50px;
    font-family: "Poppins", sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 2px;
    cursor: pointer;
    text-transform: uppercase;
    transition: opacity .2s, transform .15s;
    box-shadow: 0 6px 20px rgba(0,0,0,.2);
    display: inline-block;
  }

  #gfc-ps-{{ section.id }} .gfc-ps__cart-btn:hover:not(:disabled) {
    opacity: .87;
    transform: translateY(-2px);
  }

  #gfc-ps-{{ section.id }} .gfc-ps__cart-btn:disabled {
    opacity: .4;
    cursor: not-allowed;
  }

  #gfc-ps-{{ section.id }} .gfc-ps__cart-btn.gfc-loading {
    opacity: .55;
    cursor: not-allowed;
  }

  #gfc-ps-{{ section.id }} .gfc-ps__cart-btn.gfc-added {
    background: #3d8b5e !important;
  }

  /* ================================================================
     RESPONSIVE
  ================================================================ */

  @media screen and (max-width: 1200px) {
    #gfc-ps-{{ section.id }} .gfc-ps__inner { max-width: 940px; }
    #gfc-ps-{{ section.id }} .gfc-ps__content { padding-left: 210px; padding-right: 40px; }
    #gfc-ps-{{ section.id }} .gfc-ps__title { font-size: 30px; }
    #gfc-ps-{{ section.id }} .gfc-ps__price { font-size: 30px; }
    #gfc-ps-{{ section.id }} .gfc-ps__slider { width: 80%; }
    #gfc-ps-{{ section.id }} .gfc-ps__bg-shape { width: 44%; }
    #gfc-ps-{{ section.id }} .gfc-ps__product-img { left: 20%; width: 240px; }
  }

  @media screen and (max-width: 992px) {
    #gfc-ps-{{ section.id }} {
      padding: 40px 20px 0px;
      min-height: auto;
      align-items: flex-start;
    }

    /* Heading stays above everything */
    #gfc-ps-{{ section.id }} .gfc-ps__section-heading {
      position: relative;
      font-size: 3.5rem;
    }

    /*
      CSS Grid layout on inner:
        Row 1 (150px)  = image zone    — product image lives here
        Row 2 (auto)   = card zone     — slider card lives here
        Cols: [52px nav] [1fr card] [52px nav]

      The product image is 290px tall, overflowing row 1 by 140px —
      it straddles the junction, same visual idea as desktop.
      Nav buttons go in row 2 col 1/3 so align-self: center puts them
      exactly in the vertical middle of the card, no guesswork needed.
    */
    #gfc-ps-{{ section.id }} .gfc-ps__inner {
      display: grid;
      grid-template-rows: 150px auto;
      grid-template-columns: 52px 1fr 52px;
      height: auto;
      position: relative;
    }

    /* Coloured backdrop stays absolute — only decoration behind row 1 */
    #gfc-ps-{{ section.id }} .gfc-ps__bg-shape {
      grid-row: 1; grid-column: 1 / -1;
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 150px;
      border-radius: 20px;
      z-index: 0;
    }

    /*
      Product image spans all cols in row 1.
      Height 290px > row height 150px — overflows 140px into the card.
      align-self: start anchors it to the top of the row.
    */
    #gfc-ps-{{ section.id }} .gfc-ps__product-img {
      grid-row: 1; grid-column: 1 / -1;
      position: relative;
      left: auto; top: auto; transform: none;
      width: 100%; height: 290px;
      max-height: none;
      z-index: 2;
      align-self: start;
      pointer-events: none;
    }

    /* Items fill the container; horizontal slide-in animation */
    #gfc-ps-{{ section.id }} .gfc-ps__product-img-item {
      top: 0; bottom: 0; left: 0; right: 0;
      transform: translateX(-50px);
    }
    #gfc-ps-{{ section.id }} .gfc-ps__product-img-item.is-active {
      transform: translateX(0);
    }

    /* Prev: row 2 col 1 — align-self: center hits the card midpoint exactly */
    #gfc-ps-{{ section.id }} .gfc-ps__prev {
      grid-row: 2; grid-column: 1;
      position: relative;
      left: auto; right: auto; top: auto; bottom: auto;
      transform: translateX(50%);    /* shift right so centre sits on card left edge */
      align-self: center;
      justify-self: center;
      z-index: 2;
    }

    /* Next: row 2 col 3 */
    #gfc-ps-{{ section.id }} .gfc-ps__next {
      grid-row: 2; grid-column: 3;
      position: relative;
      left: auto; right: auto; top: auto; bottom: auto;
      transform: translateX(-50%);   /* shift left so centre sits on card right edge */
      align-self: center;
      justify-self: center;
      z-index: 2;
    }

    /* Slider card: row 2 col 2 */
    #gfc-ps-{{ section.id }} .gfc-ps__slider {
      grid-row: 2; grid-column: 2;
      position: relative;
      top: auto; right: auto; transform: none;
      width: 100%; height: auto;
      border-radius: 20px;
      box-shadow: 0 12px 40px rgba(0,0,0,.25);
    }

    /* Swiper must size to content on mobile */
    #gfc-ps-{{ section.id }} .gfc-ps__slider .swiper-wrapper { height: auto; }
    #gfc-ps-{{ section.id }} .gfc-ps__slide { height: auto; }

    #gfc-ps-{{ section.id }} .gfc-ps__card {
      height: auto;
      min-height: 280px;
      border-radius: 20px;
      align-items: flex-start;
    }

    /* padding-top clears the 140px overflow (290 - 150) + breathing room */
    #gfc-ps-{{ section.id }} .gfc-ps__content {
      padding: 155px 32px 50px;
      text-align: center;
    }

    #gfc-ps-{{ section.id }} .gfc-ps__ctr { justify-content: center; }
    #gfc-ps-{{ section.id }} .gfc-ps__labels-group { justify-content: center; }
    #gfc-ps-{{ section.id }} .gfc-ps__bottom { text-align: center; }
  }

  @media screen and (max-width: 767px) {
    #gfc-ps-{{ section.id }} .gfc-ps__section-heading { font-size: 5rem; }
    #gfc-ps-{{ section.id }} .gfc-ps__title { font-size: 24px; }
    #gfc-ps-{{ section.id }} .gfc-ps__price { font-size: 26px; }
    #gfc-ps-{{ section.id }} .gfc-ps__ctr { flex-wrap: wrap; }
    #gfc-ps-{{ section.id }} .gfc-ps__hr-v { display: none; }
    #gfc-ps-{{ section.id }} .gfc-ps__rating { width: 100%; margin-top: 14px; }
    /* Shrink image zone row, keep overflow into card */
    #gfc-ps-{{ section.id }} .gfc-ps__inner { grid-template-rows: 130px auto; }
    #gfc-ps-{{ section.id }} .gfc-ps__bg-shape { height: 130px; }
    #gfc-ps-{{ section.id }} .gfc-ps__product-img { height: 260px; }   /* overflows 130px */
    #gfc-ps-{{ section.id }} .gfc-ps__content { padding: 140px 22px 44px; }
  }

  @media screen and (max-width: 576px) {
    #gfc-ps-{{ section.id }} { padding: 30px 14px 0px; }
    #gfc-ps-{{ section.id }} .gfc-ps__section-heading { font-size: 4rem; letter-spacing: 3px; }
    #gfc-ps-{{ section.id }} .gfc-ps__title { font-size: 20px; }
    #gfc-ps-{{ section.id }} .gfc-ps__price { font-size: 22px; }
    #gfc-ps-{{ section.id }} .gfc-ps__inner {
      grid-template-rows: 110px auto;
      /* grid-template-columns: 44px 1fr 44px; */
      grid-template-columns: 20px 1fr 20px;
    }
    #gfc-ps-{{ section.id }} .gfc-ps__bg-shape { height: 110px; }
    #gfc-ps-{{ section.id }} .gfc-ps__product-img { height: 230px; }   /* overflows 120px */
    #gfc-ps-{{ section.id }} .gfc-ps__content { padding: 130px 16px 40px; }
    #gfc-ps-{{ section.id }} .gfc-ps__nav-btn { width: 44px; height: 44px; }
    #gfc-ps-{{ section.id }} .gfc-ps__prev { transform: translateX(25%); }
    #gfc-ps-{{ section.id }} .gfc-ps__next { transform: translateX(-25%); }
    #gfc-ps-{{ section.id }} .gfc-ps__cart-btn { width: 100%; max-width: 260px; text-align: center; }
  }
</style>

{%- comment -%} Variant data per block {%- endcomment -%}
{%- for block in section.blocks -%}
  {%- if block.settings.product != blank -%}
    <script type="application/json" id="gfc-ps-data-{{ block.id }}">{{ block.settings.product.variants | json }}</script>
  {%- endif -%}
{%- endfor -%}

<section id="gfc-ps-{{ section.id }}" aria-label="{{ section.settings.section_heading | escape }}">

  {%- if section.settings.heading_text != blank -%}
    <h2 class="gfc-ps__section-heading">{{ section.settings.heading_text | escape }}</h2>
  {%- endif -%}

  <div class="gfc-ps__inner">

    <div class="gfc-ps__bg-shape"></div>

    {%- comment -%} Floating product images — one per block, switched by JS on slide change {%- endcomment -%}
    <div class="gfc-ps__product-img" id="gfc-ps-imgs-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <div
          class="gfc-ps__product-img-item{% if forloop.first %} is-active{% endif %}"
          data-img-index="{{ forloop.index0 }}"
        >
          {%- if block.settings.product_image != blank -%}
            <img
              src="{{ block.settings.product_image | image_url: width: 500 }}"
              alt="{{ block.settings.product_image.alt | default: p.title }}"
              loading="lazy"
              width=""
              height=""
            >
          {%- elsif p != blank and p.featured_image != blank -%}
            <img
              src="{{ p.featured_image | image_url: width: 500 }}"
              alt="{{ p.title }}"
              loading="lazy"
              width=""
              height=""
            >
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%} Nav buttons — outside swiper, positioned on .gfc-ps__inner {%- endcomment -%}
    <button class="gfc-ps__nav-btn gfc-ps__prev" id="gfc-ps-prev-{{ section.id }}" aria-label="Previous slide">
      <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M0.704 17.696l9.856 9.856c0.896 0.896 2.432 0.896 3.328 0s0.896-2.432 0-3.328l-5.792-5.856h21.568c1.312 0 2.368-1.056 2.368-2.368s-1.056-2.368-2.368-2.368h-21.568l5.824-5.824c0.896-0.896 0.896-2.432 0-3.328-0.48-0.48-1.088-0.704-1.696-0.704s-1.216 0.224-1.696 0.704l-9.824 9.824c-0.448 0.448-0.704 1.056-0.704 1.696s0.224 1.248 0.704 1.696z"/></svg>
    </button>
    <button class="gfc-ps__nav-btn gfc-ps__next" id="gfc-ps-next-{{ section.id }}" aria-label="Next slide">
      <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M31.296 14.336l-9.888-9.888c-0.896-0.896-2.432-0.896-3.328 0s-0.896 2.432 0 3.328l5.824 5.856h-21.536c-1.312 0-2.368 1.056-2.368 2.368s1.056 2.368 2.368 2.368h21.568l-5.856 5.824c-0.896 0.896-0.896 2.432 0 3.328 0.48 0.48 1.088 0.704 1.696 0.704s1.216-0.224 1.696-0.704l9.824-9.824c0.448-0.448 0.704-1.056 0.704-1.696s-0.224-1.248-0.704-1.664z"/></svg>
    </button>

    {%- comment -%} Swiper {%- endcomment -%}
    <div class="gfc-ps__slider swiper" id="gfc-ps-slider-{{ section.id }}">
      <div class="swiper-wrapper">

        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          {%- assign first_variant = product.selected_or_first_available_variant -%}
          {%- assign rating_dash = block.settings.rating_value | times: 2.9531 | round: 1 -%}

          <div
            class="swiper-slide gfc-ps__slide"
            data-block-id="{{ block.id }}"
            data-slide-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            {%- comment -%}
              --gfc-text is the per-product text colour.
              All text inside .gfc-ps__content inherits via var(--gfc-text, #fff).
            {%- endcomment -%}
            <div
              class="gfc-ps__card"
              style="background-color: {{ block.settings.slide_bg_color }}; --gfc-text: {{ block.settings.text_color }};"
            >
              <div class="gfc-ps__content">

                {%- if block.settings.badge != blank -%}
                  <span class="gfc-ps__badge">{{ block.settings.badge }}</span>
                {%- endif -%}

                <h2 class="gfc-ps__title">
                  {%- if product != blank -%}{{ product.title }}{%- else -%}{{ block.settings.custom_title | default: 'Select a Product' }}{%- endif -%}
                </h2>

                <span class="gfc-ps__price" id="gfc-ps-price-{{ block.id }}">
                  {%- if product != blank -%}
                    {{ first_variant.price | money }}
                    {%- if first_variant.compare_at_price > first_variant.price -%}
                      <s>{{ first_variant.compare_at_price | money }}</s>
                    {%- endif -%}
                  {%- else -%}&nbsp;{%- endif -%}
                </span>

                <div class="gfc-ps__ctr">

                  {%- if product != blank and product.has_only_default_variant == false -%}
                    <div class="gfc-ps__labels-wrap">
                      {%- for option in product.options_with_values -%}
                        <div class="gfc-ps__labels-title">{{ option.name }}</div>
                        <div class="gfc-ps__labels-group">
                          {%- for value in option.values -%}
                            <label class="gfc-ps__label-item">
                              <input
                                type="radio"
                                class="gfc-ps__label-checkbox"
                                name="gfc-ps-{{ block.id }}-opt{{ option.position }}"
                                value="{{ value | escape }}"
                                data-block-id="{{ block.id }}"
                                data-option-position="{{ option.position }}"
                                {% if forloop.first %}checked{% endif %}
                              >
                              <span class="gfc-ps__label-txt">{{ value }}</span>
                            </label>
                          {%- endfor -%}
                        </div>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.show_rating -%}
                    {%- if product != blank and product.has_only_default_variant == false -%}
                      <span class="gfc-ps__hr-v" aria-hidden="true"></span>
                    {%- endif -%}
                    <div class="gfc-ps__rating">
                      <div class="gfc-ps__rating-percent">
                        <svg xmlns="http://www.w3.org/2000/svg" width="90" height="90" viewBox="0 0 100 100" aria-hidden="true">
                          <circle cx="50" cy="50" r="47" fill="none" stroke="rgba(255,255,255,0.15)" stroke-width="5"/>
                          <circle
                            class="gfc-ps__rating-arc"
                            cx="50" cy="50" r="47"
                            fill="none"
                            stroke="{{ block.settings.rating_color }}"
                            stroke-width="5"
                            stroke-linecap="round"
                            stroke-dasharray="0 295"
                            data-target-dash="{{ rating_dash }}"
                            style="transform: rotate(-90deg); transform-origin: 50% 50%;"
                          />
                        </svg>
                        <div class="gfc-ps__rating-num">{{ block.settings.rating_value }}%</div>
                      </div>
                      <span class="gfc-ps__rating-label">{{ block.settings.rating_label }}</span>
                    </div>
                  {%- endif -%}

                </div>

                {%- if section.settings.show_add_to_cart -%}
                  <div class="gfc-ps__bottom">
                    {%- if product != blank -%}
                      <form class="gfc-ps__atc-form" id="gfc-ps-form-{{ block.id }}" data-block-id="{{ block.id }}">
                        <input type="hidden" class="gfc-ps__variant-id" value="{{ first_variant.id }}">
                        <button
                          type="submit"
                          class="gfc-ps__cart-btn"
                          style="background-color: {{ block.settings.cart_btn_color }};"
                          {% unless product.available %}disabled{% endunless %}
                        >
                          {%- if product.available -%}{{ section.settings.cart_button_text }}{%- else -%}Sold Out{%- endif -%}
                        </button>
                      </form>
                    {%- else -%}
                      <button class="gfc-ps__cart-btn" style="background-color: {{ block.settings.cart_btn_color }};" disabled>
                        {{ section.settings.cart_button_text }}
                      </button>
                    {%- endif -%}
                  </div>
                {%- endif -%}

              </div>
            </div>
          </div>

        {%- endfor -%}
      </div>
    </div>

  </div>
</section>

<script>
(function () {
  var SECTION_ID = '{{ section.id }}';
  var CART_TEXT  = '{{ section.settings.cart_button_text | escape }}';
  var MONEY_FMT  = '{{ shop.money_format }}';

  /* ---- Rating arc animation (JS-driven, reliable across browsers) ---- */
  function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }

  function animateArc(arc) {
    if (!arc) return;
    var target   = parseFloat(arc.getAttribute('data-target-dash')) || 0;
    var duration = 900;
    var startTs  = null;
    arc.setAttribute('stroke-dasharray', '0 295');
    requestAnimationFrame(function tick(ts) {
      if (!startTs) startTs = ts;
      var pct     = Math.min((ts - startTs) / duration, 1);
      var current = target * easeOutCubic(pct);
      arc.setAttribute('stroke-dasharray', current.toFixed(2) + ' 295');
      if (pct < 1) requestAnimationFrame(tick);
    });
  }

  function resetArcs(slide) {
    if (!slide) return;
    slide.querySelectorAll('.gfc-ps__rating-arc').forEach(function (arc) {
      arc.setAttribute('stroke-dasharray', '0 295');
    });
  }

  /* ---- Floating product image switcher ---- */
  function switchImg(realIndex) {
    var imgs = document.querySelectorAll('#gfc-ps-imgs-' + SECTION_ID + ' .gfc-ps__product-img-item');
    imgs.forEach(function (el) { el.classList.remove('is-active'); });
    var target = document.querySelector(
      '#gfc-ps-imgs-' + SECTION_ID + ' [data-img-index="' + realIndex + '"]'
    );
    if (target) target.classList.add('is-active');
  }

  function init() {
    var sliderEl  = document.getElementById('gfc-ps-slider-' + SECTION_ID);
    var sectionEl = document.getElementById('gfc-ps-' + SECTION_ID);
    if (!sliderEl || !sectionEl) return;

    var swiper = new Swiper('#gfc-ps-slider-' + SECTION_ID, {
      effect: 'fade',
      fadeEffect: { crossFade: true },
      loop: {{ section.settings.loop }},
      speed: 660,
      navigation: {
        prevEl: '#gfc-ps-prev-' + SECTION_ID,
        nextEl: '#gfc-ps-next-' + SECTION_ID
      },
      {% if section.settings.autoplay %}
      autoplay: {
        delay: {{ section.settings.autoplay_delay }},
        disableOnInteraction: false,
        pauseOnMouseEnter: true
      },
      {% endif %}
      on: {
        afterInit: function () {
          switchImg(this.realIndex);
          var self = this;
          setTimeout(function () {
            var active = self.slides[self.activeIndex];
            if (active) active.querySelectorAll('.gfc-ps__rating-arc').forEach(animateArc);
          }, 200);
        },
        slideChangeTransitionStart: function () {
          resetArcs(this.slides[this.previousIndex]);
        },
        slideChange: function () {
          switchImg(this.realIndex);
        },
        slideChangeTransitionEnd: function () {
          var active = this.slides[this.activeIndex];
          if (active) active.querySelectorAll('.gfc-ps__rating-arc').forEach(animateArc);
        }
      }
    });

    /* ---- Variant selection ---- */
    sectionEl.addEventListener('change', function (e) {
      var radio = e.target;
      if (!radio.classList.contains('gfc-ps__label-checkbox')) return;

      var blockId = radio.dataset.blockId;
      var dataEl  = document.getElementById('gfc-ps-data-' + blockId);
      if (!dataEl) return;

      var variants = JSON.parse(dataEl.textContent);

      var selected = {};
      sectionEl.querySelectorAll(
        '.gfc-ps__label-checkbox[data-block-id="' + blockId + '"]:checked'
      ).forEach(function (r) {
        selected[parseInt(r.dataset.optionPosition, 10)] = r.value;
      });

      var matched = variants.find(function (v) {
        return Object.keys(selected).every(function (pos) {
          return v['option' + pos] === selected[pos];
        });
      });
      if (!matched) return;

      var form = document.getElementById('gfc-ps-form-' + blockId);
      if (form) {
        form.querySelector('.gfc-ps__variant-id').value = matched.id;
        var btn = form.querySelector('.gfc-ps__cart-btn');
        if (btn) {
          btn.disabled    = !matched.available;
          btn.textContent = matched.available ? CART_TEXT : 'Sold Out';
        }
      }

      var priceEl = document.getElementById('gfc-ps-price-' + blockId);
      if (priceEl) {
        var html = fmtMoney(matched.price);
        if (matched.compare_at_price && matched.compare_at_price > matched.price) {
          html += ' <s>' + fmtMoney(matched.compare_at_price) + '</s>';
        }
        priceEl.innerHTML = html;
      }
    });

    /* ---- AJAX Add to Cart ---- */
    sectionEl.addEventListener('submit', function (e) {
      var form = e.target;
      if (!form.classList.contains('gfc-ps__atc-form')) return;
      e.preventDefault();

      var variantId = parseInt(form.querySelector('.gfc-ps__variant-id').value, 10);
      if (!variantId) return;

      var btn      = form.querySelector('.gfc-ps__cart-btn');
      var origText = btn.textContent;
      btn.classList.add('gfc-loading');
      btn.disabled = true;
      btn.textContent = 'Adding…';

      fetch('/cart/add.js', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body:    JSON.stringify({ id: variantId, quantity: 1 })
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        btn.classList.remove('gfc-loading');
        if (data.id) {
          btn.classList.add('gfc-added');
          btn.textContent = 'Added!';
          fetch('/cart.js').then(function (r) { return r.json(); }).then(function (cart) {
            document.dispatchEvent(new CustomEvent('cart:refresh', { detail: cart, bubbles: true }));
            var bubble = document.querySelector('#cart-icon-bubble .cart-count-bubble span');
            if (bubble) bubble.textContent = cart.item_count;
          });
          setTimeout(function () {
            btn.classList.remove('gfc-added');
            btn.textContent = origText;
            btn.disabled = false;
          }, 2200);
        } else {
          btn.textContent = data.description || 'Try again';
          setTimeout(function () { btn.textContent = origText; btn.disabled = false; }, 2500);
        }
      })
      .catch(function () {
        btn.classList.remove('gfc-loading');
        btn.textContent = 'Error – try again';
        setTimeout(function () { btn.textContent = origText; btn.disabled = false; }, 2500);
      });
    });
  }

  function fmtMoney(cents) {
    var val = (cents / 100).toFixed(2);
    return MONEY_FMT
      .replace('{{amount}}',                     val)
      .replace('{{amount_no_decimals}}',          Math.round(cents / 100))
      .replace('{{amount_with_comma_separator}}', val.replace('.', ','))
      .replace(/\{\{[^}]+\}\}/g,                 val);
  }

  if (typeof Swiper === 'undefined') {
    var sc = document.createElement('script');
    sc.src = 'https://cdn.jsdelivr.net/npm/swiper@8/swiper-bundle.min.js';
    sc.onload = init;
    document.head.appendChild(sc);
  } else {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  }
})();
</script>

{% schema %}
{
  "name": "GFC Product Slider",
  "tag": "div",
  "class": "gfc-product-slider-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Section Heading"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading Text",
