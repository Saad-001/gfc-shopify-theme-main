        },
        {
          "type": "header",
          "content": "Badge & Fallback"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Text",
          "info": "e.g. NEW · SALE · BESTSELLER — leave blank to hide"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Fallback Title",
          "info": "Shown only when no product is selected",
          "default": "Product Name"
        },
        {
          "type": "header",
          "content": "Rating Circle"
        },
        {
          "type": "checkbox",
          "id": "show_rating",
          "label": "Show Rating",
          "default": true
        },
        {
          "type": "range",
          "id": "rating_value",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Rating Value",
          "default": 80
        },
        {
          "type": "color",
          "id": "rating_color",
          "label": "Rating Progress Color",
          "default": "#cc3342"
        },
        {
          "type": "text",
          "id": "rating_label",
          "label": "Rating Label",
          "default": "QUALITY SCORE"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GFC Product Slider",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "custom_title": "Ethiopia Yirgacheffe",
            "slide_bg_color": "#2c1810",
