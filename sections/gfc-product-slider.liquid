      "default": 5000
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop",
      "default": true
    },
    {
      "type": "header",
      "content": "Cart Button"
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show Add to Cart",
      "default": true
    },
    {
      "type": "text",
      "id": "cart_button_text",
      "label": "Button Text",
      "default": "ADD TO CART"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Product Slide",
