          "settings": {
            "custom_title": "Colombian Supremo",
            "slide_bg_color": "#1a2c18",
            "text_color": "#ffffff",
            "cart_btn_color": "#4a7c59",
            "rating_value": 85,
            "rating_color": "#5db87a",
            "rating_label": "QUALITY SCORE"
          }
        },
        {
          "type": "slide",
          "settings": {
            "custom_title": "Sumatra Dark Roast",
            "slide_bg_color": "#18202c",
            "text_color": "#ffffff",
            "cart_btn_color": "#3d5a80",
            "rating_value": 90,
            "rating_color": "#6b9fd4",
            "rating_label": "QUALITY SCORE",
            "badge": "BESTSELLER"
          }
        }
      ]
    }
  ],
  "max_blocks": 10
}
