<style>
  .gfc-sub-grain {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    opacity: 0.1;
  }
</style>

<section class="py-24 relative overflow-hidden" id="gfc-sub-{{ section.id }}">
  <div class="gfc-sub-grain absolute inset-0 pointer-events-none"></div>

  <div class="page-width mx-auto px-12 relative grid md:grid-cols-2 items-center gap-16">

    <!-- Left: steps -->
    <div class="order-2 md:order-1">
      <h2 class="text-6xl font-headline mb-8 leading-tight text-brand-offwhite uppercase">
        {{ section.settings.heading_prefix }}
        <span class="text-brand-silver">{{ section.settings.heading_accent }}</span>
      </h2>

      <div class="space-y-8 mb-10">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'step' -%}
              <div class="flex items-start gap-6" {{ block.shopify_attributes }}>
                <div class="bg-brand-offwhite text-brand-burgundy w-10 h-10 flex items-center justify-center rounded-full font-headline text-xl flex-shrink-0">{{ forloop.index }}</div>
                <div>
                  <h4 class="text-2xl font-headline mb-2 text-brand-offwhite uppercase">{{ block.settings.title }}</h4>
                  <p class="text-brand-offwhite/80 font-body">{{ block.settings.description }}</p>
                </div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>

      <a href="{{ section.settings.cta_link }}" class="inline-block bg-brand-offwhite text-brand-burgundy font-headline text-xl uppercase px-10 py-5 rounded-lg hover:scale-105 transition-transform shadow-xl no-underline">
        {{ section.settings.cta_label }}
      </a>
    </div>

    <!-- Right: image -->
    <div class="order-1 md:order-2 flex justify-center">
      <div class="relative">
        {%- if section.settings.image != blank -%}
          <img
            class="w-80 h-80 md:w-96 md:h-96 object-cover drop-shadow-[0_20px_50px_rgba(0,0,0,0.5)]"
            src="{{ section.settings.image | image_url: width: 480 }}"
            alt="{{ section.settings.image.alt | default: 'Subscription' }}"
            width="480"
            height="480"
            loading="lazy"
          >
        {%- else -%}
          <div class="w-80 h-80 md:w-96 md:h-96 rounded-full bg-brand-oxblood flex items-center justify-center drop-shadow-[0_20px_50px_rgba(0,0,0,0.5)]">
            <span class="material-symbols-outlined text-8xl text-brand-aluminum">coffee</span>
          </div>
        {%- endif -%}

        <div class="absolute -bottom-4 -right-4 bg-brand-ash border-4 border-brand-burgundy px-6 py-4 rounded-lg rotate-3">
          <p class="font-headline text-xl tracking-widest text-center text-brand-offwhite">JOINED BY<br>THOUSANDS</p>
        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "GFC Subscription",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading Prefix",
      "default": "NEVER RUN OUT OF"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading Accent",
      "default": "GRACE"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Label",
      "default": "JOIN THE CONGREGATION"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right Side Image"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "PICK YOUR BLESSING"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step Description",
          "default": "Choose your favorite blends and the frequency that suits your soul's rhythm."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GFC Subscription",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "PICK YOUR BLESSING",
            "description": "Choose your favorite blends and the frequency that suits your soul's rhythm."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "SET THE TEMPO",
            "description": "Monthly, bi-weekly, or weekly. We roast it fresh and ship it immediately."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "SAVE & SIP",
            "description": "Enjoy 15% off every order plus exclusive access to experimental roasts."
          }
        }
      ]
    }
  ]
}
{% endschema %}
